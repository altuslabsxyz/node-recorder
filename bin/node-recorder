#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=lib/log.sh
source "${SCRIPT_DIR}/lib/log.sh"
# shellcheck source=lib/config.sh
source "${SCRIPT_DIR}/lib/config.sh"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/cometbft.sh
source "${SCRIPT_DIR}/lib/cometbft.sh"
# shellcheck source=lib/prometheus.sh
source "${SCRIPT_DIR}/lib/prometheus.sh"
# shellcheck source=lib/state.sh
source "${SCRIPT_DIR}/lib/state.sh"
# shellcheck source=lib/incident.sh
source "${SCRIPT_DIR}/lib/incident.sh"
# shellcheck source=lib/mempool.sh
source "${SCRIPT_DIR}/lib/mempool.sh"
# shellcheck source=lib/manifest.sh
source "${SCRIPT_DIR}/lib/manifest.sh"
# shellcheck source=lib/s3.sh
source "${SCRIPT_DIR}/lib/s3.sh"
# shellcheck source=lib/slack.sh
source "${SCRIPT_DIR}/lib/slack.sh"
# shellcheck source=lib/retention.sh
source "${SCRIPT_DIR}/lib/retention.sh"

# run_capture <node> <alertname>
# Runs Capture Flow steps 4-13 from docs/spec/node-recorder.md synchronously,
# holding the run lock for the duration: creates the incident working
# directory, runs the Stablevisor/pprof capture script, collects mempool
# status, then runs the HAProxy capture script -- each records per-artifact
# outcomes in the incident directory's results.tsv -- writes manifest.json
# from those outcomes, then uploads every pending bundle (this incident's
# and any earlier ones whose upload failed -- the spec's "retried on the
# next run"), posts the incident summary to Slack, then prunes old uploaded
# bundles per LOCAL_RETENTION_COUNT. Always returns 0: this file runs under
# `set -e`, and a failed collection must never take the watcher down with it.
# The *_BIN variables exist so tests can substitute the capture scripts.
run_capture() {
  local node="$1"
  local alertname="$2"
  local stablevisor_pprof_bin="${CAPTURE_STABLEVISOR_PPROF_BIN:-${SCRIPT_DIR}/bin/capture-stablevisor-pprof.sh}"
  local haproxy_log_bin="${CAPTURE_HAPROXY_LOG_BIN:-${SCRIPT_DIR}/bin/capture-haproxy-log.sh}"

  local triggered_at_epoch
  triggered_at_epoch="$(date +%s)"

  # block_lag is the MVP's only trigger; CPU/RAM/disk triggers are deferred.
  local incident_dir
  if ! incident_dir="$(incident_create "$INCIDENTS_DIR" "block_lag")"; then
    log_error "run_capture: could not create an incident directory under ${INCIDENTS_DIR}, skipping collection for node=${node} alertname=${alertname}"
    return 0
  fi

  log_info "run_capture: node=${node} alertname=${alertname} collecting into ${incident_dir}"

  # Order matters beyond the spec's step numbering: the stablevisor/pprof
  # script truncates results.tsv as its own initialization, while mempool
  # collection and the haproxy script both append, so running either before
  # it would have its result wiped.
  "$stablevisor_pprof_bin" "$incident_dir" \
    || log_error "run_capture: ${stablevisor_pprof_bin} exited $?"

  local mempool_timeout_seconds="${MEMPOOL_TIMEOUT_SECONDS:-10}"
  mempool_collect "$incident_dir/results.tsv" "$DAEMON_HOME" \
    "$incident_dir/mempool.json" "$mempool_timeout_seconds" \
    || log_error "run_capture: mempool_collect failed for ${incident_dir}"

  "$haproxy_log_bin" "$incident_dir" "$triggered_at_epoch" \
    || log_error "run_capture: ${haproxy_log_bin} exited $?"

  manifest_write "$incident_dir" "$node" "$CHAIN" "block_lag" "$triggered_at_epoch" \
    || log_error "run_capture: manifest_write failed for ${incident_dir}"

  s3_upload_pending "$INCIDENTS_DIR" \
    || log_error "run_capture: pending-upload scan failed for ${INCIDENTS_DIR}"

  slack_notify_incident "$incident_dir" \
    || log_error "run_capture: slack notification failed for ${incident_dir}"

  retention_prune "$INCIDENTS_DIR" \
    || log_error "run_capture: retention prune failed for ${INCIDENTS_DIR}"

  log_info "run_capture: done, manifest at ${incident_dir}/manifest.json"
  return 0
}

poll_once() {
  if ! acquire_run_lock; then
    log_info "previous run in progress, skipping this cycle"
    return 0
  fi

  local alert_state
  if ! alert_state=$(query_alert_state); then
    release_run_lock
    return 0
  fi

  case "$alert_state" in
    firing)
      if in_cooldown "$NODE_ID" "$ALERT_NAME"; then
        log_info "node=${NODE_ID} alertname=${ALERT_NAME} is firing but in cooldown, skipping"
      else
        set_state "$NODE_ID" "$ALERT_NAME" "capturing" 0
        run_capture "$NODE_ID" "$ALERT_NAME"
        set_state "$NODE_ID" "$ALERT_NAME" "cooldown" "$(( $(date +%s) + COOLDOWN_SECONDS ))"
      fi
      ;;
    pending|absent)
      : # no alert, nothing to do
      ;;
  esac

  release_run_lock
  return 0
}

main() {
  load_config
  log_info "node-recorder starting: node=${NODE_ID} alertname=${ALERT_NAME} poll_interval=${POLL_INTERVAL_SECONDS}s"

  # Advisory, never fatal -- hence the `|| true` under this file's `set -e`.
  # Prometheus is routinely unreachable at boot (both come up together), and
  # under systemd's Restart=always a hard failure here would be a crash loop
  # rather than a diagnosis. Logging is the whole point: see the function.
  verify_node_label_match || true

  while true; do
    poll_once
    sleep "$POLL_INTERVAL_SECONDS"
  done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main
fi
